# Meta app id and secret. Facebook Login for Business configuration id
# from the app dashboard (Configurations). That configuration is Unified Login.
META_APP_ID=
META_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=

# Must match a Valid OAuth Redirect URI on Facebook Login for Business.
# lvh.me resolves to 127.0.0.1. Facebook App Domains rejects raw IP addresses.
# PythonAnywhere: https://YOUR_USERNAME.pythonanywhere.com/instagram/callback
REDIRECT_URI=https://lvh.me:5000/instagram/callback

GRAPH_VERSION=v26.0
SECRET_KEY=change-me-to-a-long-random-string

# 1 whenever the site is HTTPS, including local https://127.0.0.1
COOKIE_SECURE=1
