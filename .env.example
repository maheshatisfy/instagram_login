# Instagram app (Instagram Login product, not Facebook Login).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must match the redirect URI saved on the Instagram app, exactly.
# Local:  http://127.0.0.1:5000/instagram/callback
# PythonAnywhere: https://YOUR_USERNAME.pythonanywhere.com/instagram/callback
REDIRECT_URI=http://127.0.0.1:5000/instagram/callback

GRAPH_VERSION=v26.0
SECRET_KEY=change-me-to-a-long-random-string

# 1 on PythonAnywhere (HTTPS). 0 only for local http://127.0.0.1
COOKIE_SECURE=0
